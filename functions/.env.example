# 拷貝成 functions/.env 或 functions/.env.ntu-magic-night
# Secret 類（GMAIL_PASSWORD）不要放這，改用 Cloud Secret Manager：
#   firebase functions:secrets:set GMAIL_PASSWORD

# 寄信使用的 Gmail 帳號
GMAIL_ACCOUNT=ntumagic@gmail.com

# Admin 身分用 Firebase Auth custom claim（admin: true）控制，不在 env 裡
# 設定方式：cd scripts && npm run set-admin <email>（詳見 README）
