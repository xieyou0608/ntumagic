# 拷貝成 functions/.env 或 functions/.env.ntu-magic-night
# Secret 類（GMAIL_PASSWORD / EMAIL_HASH_SECRET）不要放這，改用 Cloud Secret Manager：
#   firebase functions:secrets:set GMAIL_PASSWORD
#   firebase functions:secrets:set EMAIL_HASH_SECRET

# Admin 登入用的 email（在 Firebase Console > Auth 手動建好同一個帳號）
ADMIN_EMAIL=admin@example.com

# 寄信使用的 Gmail 帳號
GMAIL_ACCOUNT=ntumagic@gmail.com

# 驗證信連結的前端 URL
VERIFY_BASE_URL=https://www.ntumagic.club/verify
